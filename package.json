{
  "name": "max",
  "productName": "Max",
  "version": "0.1.0",
  "description": "Multi-session workspace UI for Claude Code agents",
  "main": "main/index.js",
  "private": true,
  "author": "Joyet George",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --mac --arm64",
    "dist:dir": "electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@phosphor-icons/web": "^2.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^15.0.12",
    "material-icon-theme": "^5.40.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "vanilla-jsoneditor": "^3.13.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.max.deck",
    "productName": "Max",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/build/Release/**"
    ],
    "files": [
      "main/**",
      "renderer/**",
      "package.json",
      "!node_modules/**/{README,CHANGELOG,HISTORY}*",
      "!node_modules/**/*.{md,map,ts,d.ts}",
      "!node_modules/@phosphor-icons/web/src/{bold,duotone,fill,light,thin}/**",
      "!node_modules/node-pty/{deps,src,third_party,scripts,typings,node-addon-api,prebuilds}/**",
      "!node_modules/node-pty/build/Release/obj.target/**",
      "!node_modules/node-pty/build/Release/node-addon-api/**",
      "!node_modules/node-pty/build/{Makefile,config.gypi,*.mk,*.Makefile}",
      "!node_modules/node-pty/build/**/*.{d,o}",
      "!node_modules/@highlightjs/cdn-assets/{es,styles}/**",
      "!node_modules/monaco-editor/{esm,dev}/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Max opens files in your editor."
      },
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Max"
    }
  }
}
